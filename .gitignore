###################################
# PYTHON
###################################
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

###################################
# DJANGO
###################################
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3

###################################
# MIGRATIONS — la PROD génère les siennes
# Sur le serveur : python manage.py makemigrations && migrate
###################################
**/migrations/*.py
!**/migrations/__init__.py
**/migrations/*.pyc
**/migrations/__pycache__/

###################################
# ENVIRONNEMENT & SECRETS
###################################
.env
.env.*
*.env
.env.local
.env.dev
.env.prod
.env.test
# Garder seulement le template
!.env.example

###################################
# STATIC & MEDIA (générés sur le serveur)
###################################
media/
staticfiles/
static_root/

###################################
# COLLECTSTATIC
###################################
/collections_management/static/

###################################
# LOGS
###################################
logs/
*.log
*.out

###################################
# TESTS / COVERAGE
###################################
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.tox/

###################################
# EXPORTS / RAPPORTS (générés à la volée)
###################################
*.csv
*.xls
*.xlsx
*.ods
*.pdf
*.zip
*.rar

###################################
# CACHE / SESSIONS
###################################
.cache/
.sessions/
celerybeat-schedule
celerybeat.pid

###################################
# DOCKER
###################################
.env.docker
docker-compose.override.yml

###################################
# IDE - VSCODE
###################################
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

###################################
# IDE - PYCHARM
###################################
.idea/
*.iml

###################################
# OS
###################################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

###################################
# VIRTUAL ENVIRONMENTS
###################################
venv/
.venv/
env/
ENV/

###################################
# NODE (si frontend intégré)
###################################
node_modules/
dist/
build/

###################################
# TEMP
###################################
*.tmp
*.swp
*.bak
