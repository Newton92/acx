# ── Copier ce fichier en .env et remplir les vraies valeurs ───────────────────
# NE JAMAIS commiter le fichier .env dans git

# ── Django ─────────────────────────────────────────────────────────────────────
SECRET_KEY=changez-moi-par-une-vraie-cle-secrete-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,IP_DU_SERVEUR

# ── Base de données PostgreSQL ─────────────────────────────────────────────────
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://acx_user:mot_de_passe_db@127.0.0.1:5432/acx_db

# ── CORS (origines autorisées pour le frontend) ────────────────────────────────
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# ── Email SMTP ─────────────────────────────────────────────────────────────────
EMAIL_HOST=10.0.168.4
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=acx@acremac.com
EMAIL_HOST_PASSWORD=v4>&3k=71Z+"
DEFAULT_FROM_EMAIL=acx@acremac.com

# ── URLs du frontend ───────────────────────────────────────────────────────────
FRONTEND_BASE_URL=https://votre-domaine.com
